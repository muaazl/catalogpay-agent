# Copy to backend/.env. All values have safe local defaults.
APP_NAME="CatalogPay Agent"
ENVIRONMENT=local
# SQLite (default, WAL mode) or e.g. postgresql+psycopg://user:pass@localhost:5432/catalogpay
DATABASE_URL=sqlite:///./catalogpay.db
SEED_ON_STARTUP=true
MATCH_CONFIDENCE_THRESHOLD=0.62
LOW_CONFIDENCE_THRESHOLD=0.40

# Gemini multimodal order parser. Leave the key empty to use the offline regex parser for text
# (media uploads then return 503). Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT_SECONDS=20
MAX_UPLOAD_BYTES=10485760

# PayPal REST (Orders v2 + Payouts v1). Leave the credentials empty to run the full
# checkout -> capture -> split-payout lifecycle in deterministic sandbox_simulation mode.
# Sandbox apps: https://developer.paypal.com/dashboard/applications/sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENV=sandbox
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
PAYPAL_WEBHOOK_ID=
PAYPAL_TIMEOUT_SECONDS=20
PAYPAL_SANDBOX_MOCK_FALLBACK=true
PAYPAL_RETURN_URL=http://localhost:5173/checkout/return
PAYPAL_CANCEL_URL=http://localhost:5173/checkout/cancel
