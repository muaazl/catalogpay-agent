# Copy to backend/.env. All values have safe local defaults.
APP_NAME="CatalogPay Agent"
ENVIRONMENT=local
# SQLite (default, WAL mode) or e.g. postgresql+psycopg://user:pass@localhost:5432/catalogpay
DATABASE_URL=sqlite:///./catalogpay.db
SEED_ON_STARTUP=true
MATCH_CONFIDENCE_THRESHOLD=0.62
LOW_CONFIDENCE_THRESHOLD=0.40

# Gemini multimodal order parser. Leave the key empty to use the offline regex parser for text
# (media uploads then return 503). Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT_SECONDS=20
MAX_UPLOAD_BYTES=10485760
