# Keep the build context small and secrets out of the image.
.git
.github
.vscode
.idea
**/.env
**/.env.*
!**/.env.example

# Python
**/__pycache__
**/*.py[cod]
**/.venv
**/.pytest_cache
**/.ruff_cache
**/*.egg-info
backend/tests

# Node
**/node_modules
frontend/dist
frontend/coverage

# Local databases
**/*.db
**/*.db-wal
**/*.db-shm

# Docs and media not needed at runtime
docs
samples
*.md
!frontend/**/*.md
